# Copia este archivo a .env antes de levantar la beta.
# Si una clave queda vacía, esa integración usa el simulador y el panel sigue funcionando.

# Postgres. En Neon u otro servicio con pooler, usa la URL directa en DIRECT_URL
# (Prisma la necesita para las migraciones) y la URL con pooler en DATABASE_URL.
DATABASE_URL="postgresql://brazo:brazo@localhost:5432/brazo_derecho"
DIRECT_URL="postgresql://brazo:brazo@localhost:5432/brazo_derecho"

# Mínimo 32 caracteres. Cámbiala antes de cualquier despliegue.
SESSION_SECRET="cambia-esta-clave-por-una-de-al-menos-32-caracteres"

# URL pública del sitio, sin barra final. Flow la usa para avisar pagos.
# En local puedes dejar el valor de abajo. En Vercel pon https://tu-dominio.cl
APP_URL="http://localhost:3000"

# xAI. Vacío = simulador, sin red. Con clave, el panel llama a la Responses API.
# XAI_MODE=mock obliga al simulador aunque exista XAI_API_KEY.
XAI_API_KEY=""
XAI_API_URL="https://api.x.ai/v1"
XAI_MODE="mock"
# Tareas habituales (Atención WhatsApp y el prompt de imagen). Solo grok-4.3 o grok-4.7.
XAI_MODEL_ROUTINE="grok-4.3"
# Tareas complejas (Cotizador y Marketing).
XAI_MODEL_COMPLEX="grok-4.7"

# Precio mensual bruto de IA Bot, IVA incluido, en pesos enteros. Default del código: 63546.
# La portada lo muestra como «$63.546 al mes, IVA incluido». Mercado Pago cobra el mismo monto.
# Vacío usa 63546. Si queda el neto antiguo 53400, también se usa 63546.
# Otro entero positivo reemplaza el default.
IABOT_PRICE_CLP="63546"

# Estimado de consumo. Vacío = tarifas fijas de grok-4.3 y grok-4.7 en el código
# (hay que refrescarlas desde https://docs.x.ai). No son una tarifa en vivo.
# USD por millón de tokens. Si una queda vacía, esa parte usa la constante del modelo.
USAGE_USD_PER_M_INPUT=""
USAGE_USD_PER_M_CACHED=""
USAGE_USD_PER_M_OUTPUT=""
# Dólar de trabajo para pasar el estimado a pesos. Vacío = 900. No es el tipo de cambio del día.
USAGE_FX_CLP_PER_USD=""
# Costo del computador en la nube del período, en USD. Vacío = 0. No se cobra solo.
USAGE_COMPUTER_USD=""

# Flow. Si faltan la api key o el secreto, la prueba de 7 días se activa en el panel.
# «Activar plan» abre un checkout simulado («Pago de prueba») y no hay cobro.
# La URL por defecto es el sandbox.
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_API_URL="https://sandbox.flow.cl/api"

# Mercado Pago, suscripciones (preapproval). Si falta el access token, se usa el mismo
# pago de prueba que Flow: no hay llamada a la API. El webhook exige el secreto.
# MERCADOPAGO_PUBLIC_KEY es opcional: el cobro del servidor no la usa.
# Un token de prueba de Mercado Pago empieza con TEST-. No pongas claves reales aquí.
# MERCADOPAGO_TEST_PAYER_EMAIL es opcional. Si el access token empieza con TEST- y esta
# variable tiene valor, POST /preapproval envía ese correo como payer_email en lugar del
# correo de la sesión. Si el token no empieza con TEST- (producción), se ignora.
# Si Mercado Pago rechaza la llamada, el log anota el código HTTP y los campos message
# y cause. No anota el token, las cabeceras ni otros secretos.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_TEST_PAYER_EMAIL=""

# WhatsApp Cloud API de Meta. Sin estos valores el simulador del panel sigue activo.
# El webhook rechaza los POST si falta WHATSAPP_APP_SECRET.
# WHATSAPP_PHONE_NUMBER_ID es una referencia: igual hay que vincular el id a la empresa en Administración.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Correos, separados por coma, que ven Administración y pueden vincular el número de cualquier empresa.
# Si queda vacío, el dueño igual puede vincular el número de su propia empresa en Atención WhatsApp.
ADMIN_EMAILS=""

# En producción el seed no crea maria@losaromos.cl ni pedro@cafedelpuerto.cl.
# Solo el valor exacto true las carga. No lo pongas en el servidor público.
# Para bloquearlas sin borrar datos: npm run desactivar:demo
DEMO_SEED=""

# Sentry. Vacío = no se envía nada. Con un DSN, el servidor reporta los webhooks
# y el navegador reenvía el error de pantalla por /api/observabilidad.
SENTRY_DSN=""

# Resend, plan gratis. Vacío = simulador: el correo se escribe en el log y queda en Administración.
# No sale ningún mensaje. Con clave, se envía por https://api.resend.com/emails.
# onboarding@resend.dev solo entrega al correo de la cuenta de Resend, hasta verificar un dominio.
RESEND_API_KEY=""
RESEND_FROM="Brazo Derecho <onboarding@resend.dev>"

# Bóveda de claves del cliente. AES-256-GCM.
# En Vercel: Production, tipo Secret. No pegues una clave real en este archivo.
# Generar: openssl rand -base64 32
# Vacío = las APIs de la bóveda responden error y no guardan ni leen claves.
CREDENTIALS_MASTER_KEY=""

# Computador del agente (Fase 0 local / Fase 1 en dry-run).
# XAI_MODE=mock, o XAI_API_KEY vacío, deja el computador en simulador: no llama a xAI.
# XAI_API_KEY solo por entorno. No la pongas en el repo.
# XAI_COMPUTER_MODEL acepta grok-4.3 (por defecto) o grok-4.7.
XAI_COMPUTER_MODEL="grok-4.3"
# true muestra «Ver mi computador» también en producción. En local se muestra solo.
COMPUTER_PANEL=""
# URL del agente dentro del escritorio. Vacío = la tarea queda en cola y no hay red.
COMPUTER_AGENT_URL=""
COMPUTER_AGENT_TOKEN=""
# En local, tras el token de 10 minutos, el panel puede abrir este noVNC. off lo esconde.
COMPUTER_LOCAL_NOVNC=""
# Fly. Dry-run por defecto. No llama a la API salvo FLY_DRY_RUN=false, token y --confirmo-gasto.
# No crea apps ni cobra si queda vacío. FLY_API_TOKEN solo por entorno.
FLY_API_TOKEN=""
FLY_DRY_RUN="true"
FLY_ORG=""
FLY_REGION="gru"
FLY_IMAGE=""
