generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String
  passwordHash     String
  authVersion      Int          @default(0)
  emailVerifiedAt  DateTime?
  consentAt        DateTime?
  marketingOptInAt DateTime?
  createdAt        DateTime     @default(now())
  memberships      Membership[]
  authTokens       AuthToken[]
}

model Organization {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  rut                    String?
  flowCustomerId         String?         @unique
  whatsappPhoneNumberId  String?         @unique
  suspendedAt            DateTime?
  /// Cuenta de prueba interna. No se factura ni entra en métricas de cobro.
  isQa                   Boolean         @default(false)
  createdAt              DateTime        @default(now())
  memberships   Membership[]
  subscriptions Subscription[]
  knowledge     KnowledgeItem[]
  priceItems    PriceItem[]
  conversations Conversation[]
  quotes        Quote[]
  brandProfile  BrandProfile?
  posts         MarketingPost[]
  consults      AccountingConsult[]
  usageEvents   UsageEvent[]
  usageMeters   UsageMeter[]
  usageMonths   UsageMonth[]
  computer                 Computer?
  credentials              ClientCredential[]
  credentialAudits         CredentialAuditEvent[]
  credentialConfirmations  CredentialConfirmation[]
  credentialFillGrants     CredentialFillGrant[]
  agentThreads             AgentThread[]
  agentAttachments         AgentAttachment[]
}

enum MemberRole {
  OWNER
  STAFF
}

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model EmailMessage {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String   @default("")
  kind      String
  provider  String
  status    String
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole   @default(OWNER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum AgentKind {
  WHATSAPP
  QUOTES
  MARKETING
  ACCOUNTING
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELED
}

enum PaymentProvider {
  FLOW
  MERCADOPAGO
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  agent          AgentKind
  status         SubscriptionStatus
  periodStart        DateTime
  periodEnd          DateTime
  provider           PaymentProvider    @default(FLOW)
  flowSubscriptionId String?
  flowPlanId         String?
  amountClp          Int?
  mpPreapprovalId    String?            @unique
  mpPayerEmail       String?
  createdAt          DateTime           @default(now())
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agent])
  @@index([organizationId])
}

enum UsageMetric {
  RESPONSES
  QUOTES
  TEXTS
  IMAGES
  CONSULTS
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  agent          AgentKind
  metric         UsageMetric
  quantity       Int
  inputTokens    Int          @default(0)
  cachedTokens   Int          @default(0)
  outputTokens   Int          @default(0)
  model          String       @default("")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, agent, metric, createdAt])
}

/// Consumo para cobro. El cupo del plan sigue en UsageEvent.
enum UsageKind {
  TASK
  CHAT
  COMPUTER_STEP
}

model UsageMeter {
  id             String       @id @default(cuid())
  organizationId String
  kind           UsageKind
  model          String       @default("")
  inputTokens    Int          @default(0)
  cachedTokens   Int          @default(0)
  outputTokens   Int          @default(0)
  /// true: tokens del simulador, no de la API de xAI.
  synthetic      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, kind, createdAt])
}

model UsageMonth {
  id             String       @id @default(cuid())
  organizationId String
  yearMonth      String
  tasksCount     Int          @default(0)
  inputTokens    Int          @default(0)
  cachedTokens   Int          @default(0)
  outputTokens   Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, yearMonth])
  @@index([organizationId])
}

model KnowledgeItem {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PriceItem {
  id             String       @id @default(cuid())
  organizationId String
  sku            String
  name           String
  unit           String
  priceClp       Int
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteLines     QuoteLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  customerLabel  String
  externalId     String?
  channel        String       @default("simulator")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([organizationId, externalId])
  @@index([organizationId, createdAt])
}

enum MessageRole {
  CUSTOMER
  AGENT
  HUMAN
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  body           String
  escalated      Boolean      @default(false)
  refused        Boolean      @default(false)
  externalId     String?      @unique
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model FlowNotice {
  id             String    @id @default(cuid())
  token          String    @unique
  flowOrder      Int?
  paymentStatus  Int?
  organizationId String?
  agent          AgentKind?
  createdAt      DateTime  @default(now())
}

model MercadoPagoNotice {
  id             String   @id @default(cuid())
  noticeKey      String   @unique
  subscriptionId String?
  createdAt      DateTime @default(now())

  @@index([subscriptionId])
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  number         Int
  customerName   String
  notes          String       @default("")
  agentNote      String       @default("")
  unmatchedNote  String       @default("")
  status         QuoteStatus  @default(PENDING_APPROVAL)
  totalClp       Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          QuoteLine[]

  @@unique([organizationId, number])
  @@index([organizationId, createdAt])
}

model QuoteLine {
  id           String    @id @default(cuid())
  quoteId      String
  priceItemId  String
  description  String
  unit         String
  quantity     Int
  unitPriceClp Int
  quote        Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  priceItem    PriceItem @relation(fields: [priceItemId], references: [id], onDelete: Restrict)

  @@index([quoteId])
}

model BrandProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  voice          String
  audience       String
  summary        String
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum PostStatus {
  DRAFT
}

model MarketingPost {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  channel        String
  copy           String
  imagePrompt    String       @default("")
  imageSvg       String       @default("")
  status         PostStatus   @default(DRAFT)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum ComputerStatus {
  PENDING
  PROVISIONING
  RUNNING
  STOPPED
  NEEDS_QR
  ERROR
}

enum ComputerTaskStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Un computador (Fly Machine + volumen) por cliente. clientId es la organización.
// El token de noVNC se guarda solo como hash. Fase 1 no crea la máquina.
model Computer {
  id             String         @id @default(cuid())
  clientId       String         @unique
  flyApp         String         @default("")
  machineId      String         @default("")
  // Origen HTTPS alcanzable desde la app, o http://127.0.0.1 en local. Nunca *.internal.
  agentEndpoint  String         @default("")
  // Token de esa máquina, cifrado. No sale al chat, a la UI ni a los logs.
  agentTokenCiphertext String  @default("")
  agentTokenIv   String         @default("")
  agentTokenAuthTag String      @default("")
  agentPinnedAddress String     @default("")
  leaseEpoch     Int            @default(0)
  volumeId       String         @default("")
  status         ComputerStatus @default(PENDING)
  region         String         @default("gru")
  novncTokenHash String         @default("")
  novncExpiresAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks          ComputerTask[]

  @@index([status])
}

model ComputerTask {
  id         String             @id @default(cuid())
  computerId String
  clientId   String
  goal       String
  status     ComputerTaskStatus @default(QUEUED)
  sensitive  Boolean            @default(false)
  result     String             @default("")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  computer   Computer           @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([computerId])
}

/// Alta, rotación o revocación hecha por un operador. Sin token y sin URL.
model ComputerLeaseAudit {
  id             String   @id @default(cuid())
  organizationId String
  machineId      String
  operatorId     String
  action         String
  outcome        String
  leaseEpoch     Int
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

/// Acceso de un portal (SII, banco, etc.). El usuario y la clave van solo cifrados.
/// La pista de usuario no es secreta. No guardar la clave en claro.
model ClientCredential {
  id                String    @id @default(cuid())
  organizationId    String
  label             String
  portal            String
  usernameHint      String    @default("")
  ciphertext        String
  iv                String
  authTag           String
  consentAcceptedAt DateTime
  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastUsedAt        DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum CredentialAuditKind {
  CREATE
  DELETE
  USE
  CONFIRM
}

/// Uso, alta o baja de una clave. Conserva id y nombre aunque se borre el acceso.
/// Nunca lleva la clave ni el usuario completo.
model CredentialAuditEvent {
  id              String              @id @default(cuid())
  organizationId  String
  credentialId    String
  credentialLabel String
  actorUserId     String
  kind            CredentialAuditKind
  purpose         String
  success         Boolean
  createdAt       DateTime            @default(now())
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum CredentialRiskAction {
  DECLARAR
  PAGAR
}

/// Confirmación explícita para presentar una declaración o pagar. Dura minutos.
model CredentialConfirmation {
  id             String               @id @default(cuid())
  organizationId String
  actorUserId    String
  action         CredentialRiskAction
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, actorUserId, action])
}

/// Permiso de un solo uso para que el computador rellene un login. Se guarda el hash, no el token.
/// No contiene la clave.
model CredentialFillGrant {
  id                   String   @id @default(cuid())
  organizationId       String
  actorUserId          String
  tokenHash            String   @unique
  allowedCredentialIds String[]
  purpose              String
  highRisk             Boolean  @default(false)
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime @default(now())
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
}

model AccountingConsult {
  id             String       @id @default(cuid())
  organizationId String
  question       String
  answer         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// Un hilo continuo por empresa y agente. Reemplaza la consulta de un solo envío.
model AgentThread {
  id             String         @id @default(cuid())
  organizationId String
  agent          AgentKind
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AgentMessage[]

  @@unique([organizationId, agent])
  @@index([organizationId])
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

enum AgentMessageKind {
  TEXT
  CONFIRMATION
}

enum AgentConfirmation {
  PENDING
  APPROVED
  CANCELED
}

model AgentMessage {
  id              String              @id @default(cuid())
  threadId        String
  role            AgentMessageRole
  kind            AgentMessageKind    @default(TEXT)
  body            String              @default("")
  action          String              @default("")
  actionTitle     String              @default("")
  confirmation    AgentConfirmation?
  legacyConsultId String?             @unique
  createdAt       DateTime            @default(now())
  thread          AgentThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments     AgentAttachment[]

  @@index([threadId, createdAt])
}

model AgentAttachment {
  id             String       @id @default(cuid())
  messageId      String
  organizationId String
  fileName       String
  mimeType       String
  sizeBytes      Int
  bytes          Bytes
  createdAt      DateTime     @default(now())
  message        AgentMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([organizationId])
}
